{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "nextjs",  
            "runtime": "container",
            "entrypoint": "Dockerfile",
             "bindings": [
                {
                "type": "service",
                "service": "my_backend",
                "format": "url",
                "env": "BACKEND_INTERNAL_URL"      
                }
      ]
        },
        "backend": {
            "root": "backend",
            "framework": "flask",
            "entrypoint": "app.py"
        }
    },
    "rewrites": [
        {
            "source": "/api/backend(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}