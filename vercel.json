{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "nextjs",  
            "runtime": "container",
            "entrypoint": "Dockerfile"
        },
        "backend": {
            "root": "backend",
            "framework": "flask",
            "entrypoint": "app.py"
        }
    },
    "rewrites": [
        {
            "source": "/api/flask(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}