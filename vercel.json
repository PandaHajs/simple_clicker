{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "nextjs",
            "runtime": "container",
            "entrypoint": "dockerfile.nextjs"
        },
        "backend": {
            "root": "backend",
            "framework": "flask",
            "runtime": "container",
            "buildCommand": "pip install -r requirements.txt && python app.py",
            "entrypoint": "flask.dockerfile"
        }
    },
    "rewrites": [
        {
            "source": "/api/backend(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}